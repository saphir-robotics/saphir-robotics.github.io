---
import { withBase } from "../lib/urls";
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PubList from "../components/PubList.astro";
import ResearchConsole from "../components/ResearchConsole.astro";
import ResearchProject from "../components/ResearchProject.astro";
import etPoster from "../assets/projects/endotheranostics-poster.jpg";

// Funded projects, shown under the direction they belong to.
const PROJECTS = {
  soft: {
    name: "EndoTheranostics",
    tagline: "A soft everting robot for colorectal cancer screening and treatment",
    url: "https://www.endotheranostics.com/project-endotheranostics/",
    summary: [
      "A perceptive soft robot with a sleeve-like body grows deep into the colon and becomes a channel for miniaturised diagnostic and therapeutic instruments.",
      "It is designed to cleanse the colon painlessly before inspection, find polyps and characterise tissue in real time with AI-assisted multimodal imaging, and remove polyps inside a miniature mobile operating chamber with microsurgical tools.",
      "Our group develops the soft everting robot at the heart of the system.",
    ],
    facts: [
      { label: "Funding", value: "ERC Synergy Grant, €10m" },
      { label: "Target", value: "Colorectal cancer" },
      { label: "Principal investigators", value: "K. Althoefer (QMUL), A. Arezzo (Turin), B. Siciliano (Naples Federico II), S. Ourselin (KCL)" },
      { label: "Note", value: "The first ERC Synergy Grant awarded at Queen Mary" },
    ],
    video: "projects/endotheranostics.mp4",
    chapters: [
      { t: 8, label: "Rinse", text: "The everting robot grows through the colon and cleanses it ahead of inspection." },
      { t: 32, label: "Detect", text: "A robotic capsule travels along the robot, finds suspected polyps and holds one with negative pressure." },
      { t: 64, label: "Characterise", text: "Multimodal sensing at the tip: optical ultrasound and photoacoustic endomicroscopy." },
      { t: 92, label: "Remove", text: "Micro-manipulators at the tip remove the cancerous tissue." },
    ],
    poster: etPoster,
    team: ["k-althoefer", "n-dei", "c-suulker", "r-kashef", "m-sheikhsofla", "q-cong", "y-jia"],
    sources: [
      { label: "QMUL news, Oct 2023", url: "https://www.sems.qmul.ac.uk/news/6572/research-group-wins-10m-grant-to-develop-revolutionary-cancer-treatment-robot/" },
      { label: "endotheranostics.com", url: "https://www.endotheranostics.com/project-endotheranostics/" },
    ],
  },
  tactile: {
    name: "PALPABLE",
    tagline: "Bringing the sense of touch back to minimally invasive surgery",
    url: "https://palpable-project.eu/project/#solution",
    summary: [
      "In open surgery a surgeon can feel tissue with their fingers; in keyhole surgery that sense of palpation is lost, and today's surgical systems cannot give it back.",
      "PALPABLE is building a finger-like palpation tool that feels tissue stiffness and shows it to the surgeon, to help tell healthy tissue from tumour during minimally invasive surgery.",
    ],
    facts: [
      { label: "Funding", value: "EU Horizon Europe, grant no. 101092518" },
      { label: "Duration", value: "48 months, from January 2023" },
      { label: "Consortium", value: "10 partners from 7 European countries, coordinated by Tech Hive Labs" },
      { label: "Our part", value: "Soft robot and sensor fabrication, prototyping and testing" },
    ],
    parts: [
      { title: "Soft pneumatic tip", text: "A thin, pneumatically actuated end-effector with proprioceptive sensing, for more freedom of motion and accurate positioning." },
      { title: "Distributed tactile probe", text: "A tactile sensing array that presses on tissue to tell healthy from cancerous tissue." },
      { title: "Photonic read-out", text: "A non-planar photonics circuit that interrogates the tactile sensor array." },
      { title: "Distance sensing", text: "A distance-sensing module that gives a visual map of the organ being examined." },
      { title: "Stiffness reconstruction", text: "Software that rebuilds the tissue's stiffness profile and presents it to the surgeon." },
    ],
    team: ["k-althoefer", "d-osman", "a-dawood", "j-chen", "a-majumder", "q-cong"],
    sources: [{ label: "palpable-project.eu", url: "https://palpable-project.eu/project/" }],
  },
} as const;
import { getResearchGroups, getPublications, withPI } from "../lib/content";

// The three research directions (same as the homepage, with more detail).
const directions = [
  {
    title: "Soft robotics",
    plate: "soft",
    tag: "SOFT / EVERSION",
    body: [
      "We build robots from soft, compliant materials so they can bend, grow and squeeze through spaces that rigid machines cannot reach.",
      "One example is the everting robot, which grows from its tip. Because its body does not slide against its surroundings, it can move through narrow and delicate places, such as passages inside the human body.",
    ],
    keys: ["Eversion", "Continuum robots", "Compliant actuation"],
    card: ["Soft bodies", "that grow from the tip"],
  },
  {
    title: "Sensing & interaction",
    plate: "tactile",
    tag: "TACTILE / TAXEL ARRAY",
    body: [
      "We develop tactile sensors and sensing skins that let a robot feel where it is being touched and how hard.",
      "This contact information helps robots handle objects gently, recognise what they are touching, and work safely next to people.",
    ],
    keys: ["Tactile sensing", "Sensing skins", "Haptic perception"],
    card: ["A sense of touch", "where, how hard, which way"],
  },
  {
    title: "Robot autonomy",
    plate: "arm",
    tag: "AUTONOMY / REACH",
    body: [
      "We combine sensing with models of the robot and the world around it, so that robots can decide how to move with less human guidance.",
      "This covers reaching and grasping, moving through cluttered spaces, and modelling how a tool interacts with its environment.",
    ],
    keys: ["Modelling", "Navigation", "Manipulation"],
    card: ["Moving on its own", "sense, decide, reach"],
  },
] as const;

// Data-driven: papers group by their `areas` tags. Each area shows its most
// recent few with a link to the full, area-filtered Publications list.
const groups = await getResearchGroups(4);
const total = (await getPublications()).filter(withPI).length;
---

<BaseLayout
  title="Research"
  description="SAPHIR's research in soft robotics, tactile sensing and robot autonomy."
>
  <PageHeader
    index={2}
    motif="terrain"
    eyebrow="What we do"
    title="Research"
    lead="Soft bodies, a sense of touch, and the intelligence to use them. Three directions that meet whenever a robot makes physical contact with the world."
    meta="03 directions"
  >
    <Fragment slot="readout">Stiffness map · move the cursor to probe</Fragment>
  </PageHeader>

  <div class="container-page py-20">
    <div class="space-y-24">
      {directions.map((d, i) => (
        <section id={d.plate} class="scroll-mt-24">
        <div class="dir grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
          <div class:list={[i % 2 === 1 && "lg:order-2"]}>
            <ResearchConsole kind={d.plate} index={i + 1} tag={d.tag} keys={d.keys} card={d.card} />
          </div>
          <div>
            <p class="label-mono text-accent-600">0{i + 1} — Direction</p>
            <h2 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">{d.title}</h2>
            <div class="mt-6 space-y-4 text-lg leading-relaxed text-slate-600">
              {d.body.map((p) => <p>{p}</p>)}
            </div>
            <ul class="mt-7 flex flex-wrap gap-2">
              {d.keys.map((k) => <li class="label-mono border border-slate-300 px-2.5 py-1.5 text-slate-600">{k}</li>)}
            </ul>
          </div>
        </div>
          {d.plate in PROJECTS && <ResearchProject {...PROJECTS[d.plate as keyof typeof PROJECTS]} />}
        </section>
      ))}
    </div>
  </div>

  {
    groups.length > 0 && (
      <section class="border-t border-slate-200 bg-neutral-50">
        <div class="container-page space-y-16 py-20">
          <div>
            <p class="label-mono text-accent-600">From our papers</p>
            <h2 class="mt-3 font-serif text-4xl tracking-tight">Work by topic</h2>
            <p class="mt-3 text-slate-600">{total} publications, grouped by the topics they address.</p>
          </div>
          {groups.map((group) => (
            <section>
              <h3 class="flex items-baseline gap-4 border-b border-slate-900 pb-3 font-serif text-2xl tracking-tight">{group.title}</h3>
              <div class="mt-8 space-y-12">
                {group.areas.map((area) => (
                  <div id={area.slug} class="scroll-mt-24">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                      <h4 class="font-serif text-xl text-slate-900">{area.label}</h4>
                      <a href={withBase(`/publications#${area.slug}`)} class="label-mono text-slate-500 transition-colors hover:text-accent-600" data-sfx="tick">
                        All papers &rarr;
                      </a>
                    </div>
                    <p class="mt-2 max-w-3xl text-slate-600">{area.blurb}</p>
                    <div class="mt-4">
                      <PubList pubs={area.pubs} />
                    </div>
                  </div>
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
